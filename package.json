{
  "name": "trrn",
  "version": "0.0.0",
  "description": "Closure-based frontend framework on Preact. No useState, no hooks — just functions and closures.",
  "keywords": [
    "closure",
    "components",
    "framework",
    "functional",
    "hyperscript",
    "preact",
    "ui"
  ],
  "license": "MIT",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/jsx-runtime.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "preact": "11.0.0-beta.1",
    "vanity-h": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "jsdom": "^29.1.0",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14"
  },
  "packageManager": "pnpm@10.33.2"
}
